{
	"name": "obsidian-whole-tree-search",
	"version": "1.2.1",
	"description": "Search markdown files while preserving hierarchical context: displays the matched line, its immediate parent, and all nested children based on indentation.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild test/search.test.ts --bundle --platform=node --format=cjs | node && node scripts/offline-audit.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"search",
		"outliner",
		"tree",
		"hierarchy"
	],
	"author": "blursedperf",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/blursedperf/obsidian-whole-tree-search.git"
	},
	"bugs": {
		"url": "https://github.com/blursedperf/obsidian-whole-tree-search/issues"
	},
	"homepage": "https://github.com/blursedperf/obsidian-whole-tree-search#readme",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "0.21.5",
		"obsidian": "^1.13.0",
		"tslib": "2.6.2",
		"typescript": "5.4.5"
	}
}
